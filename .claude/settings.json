{
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(//Users/**/.env)",
      "Read(//Users/**/.env.local)",
      "Read(//Users/**/.env.*.local)",
      "Read(//Users/**/.ssh/**)",
      "Read(//Users/**/.aws/**)",
      "Read(//Users/**/.config/gh/**)",
      "Read(//Users/**/.claude/settings.local.json)",
      "Read(//Users/**/.claude/.credentials.json)",
      "Read(//Users/**/.netrc)",
      "Read(//Users/**/.npmrc)"
    ],
    "allow": [
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(git branch -v)",
      "Bash(git branch -a)",
      "Bash(git branch --list *)",
      "Bash(git branch --show-current)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm run build)",
      "Bash(gh repo view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh label list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh release view *)",
      "Bash(gh release list *)"
    ]
  }
}
