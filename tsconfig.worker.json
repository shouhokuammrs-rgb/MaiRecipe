{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types"
    ],
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo"
  },
  "include": [
    "src/api/**/*",
    "src/shared/**/*",
    "test/api/**/*",
    "test/shared/**/*",
    "worker-configuration.d.ts",
    "vitest.workers.config.ts"
  ]
}
